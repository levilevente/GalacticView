# Local .terraform directories
**/.terraform/*

# Terraform state files (may contain secrets)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Variable files with real secrets (keep the example file in git)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files for local-only changes
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration / plan output
.terraformrc
terraform.rc
tfplan
*.tfplan

doc.md


*.pem

k3s-remote.yaml